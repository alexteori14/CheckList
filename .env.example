# Copia este archivo a .env.local y completa los datos (NO se sube a GitHub).
# Cuenta Gmail remitente con "Contraseña de aplicación" (Cuenta Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_cuenta_remitente@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=SmartCheck <tu_cuenta_remitente@gmail.com>
# Modo pruebas: solo se envían correos a estas direcciones (separadas por coma). Déjalo vacío para enviar a todos.
MAIL_SOLO_DESTINATARIOS=puentealejandro491@gmail.com
